{
  "manifest_version": 3,
  "name": "拾流 · 网页媒体下载",
  "version": "0.1.1",
  "description": "识别当前标签页的影音与图片，保存到拾流桌面下载队列。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "scripting",
    "storage",
    "activeTab",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "拾流 · 当前页资源"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
